{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cowork-game.example/schemas/test-report-1.0.json",
  "title": "AI Cowork Game TestReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateId", "attempt", "checks", "failedChecks", "verdict", "createdAt"],
  "properties": {
    "candidateId": { "type": "string", "format": "uuid" },
    "agentSessionId": { "type": ["string", "null"], "format": "uuid" },
    "attempt": { "type": "integer", "minimum": 1 },
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "evidence"],
        "properties": {
          "checkId": {
            "enum": ["build", "page_load", "console_errors", "player_movement", "enemy_loop", "item_collection", "npc_interaction", "game_outcome"]
          },
          "status": { "enum": ["pass", "fail"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "message": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    },
    "failedChecks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["build", "page_load", "console_errors", "player_movement", "enemy_loop", "item_collection", "npc_interaction", "game_outcome"]
      }
    },
    "verdict": { "enum": ["pass", "fail", "invalid"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
